{
  "schemaVersion": 1,
  "id": "case001",
  "title": "事件001 SNS乗っ取り",
  "defaults": {
    "background": "assets/backgrounds/default-investigation.png",
    "characterIcon": "assets/icons/ayaka.png",
    "evidenceIcon": "assets/icons/ayaka.png"
  },
  "characters": [
    {
      "id": "ayaka",
      "name": "藤崎彩花",
      "role": "被害者",
      "icon": "assets/icons/ayaka.png",
      "background": "assets/backgrounds/ayaka-selection.png",
      "description": "SNSアカウントを乗っ取られた被害者。"
    },
    {
      "id": "kuroda",
      "name": "黒田恒一",
      "role": "被害関係者",
      "icon": "assets/icons/ayaka.png",
      "background": "assets/backgrounds/default-investigation.png",
      "description": "彩花の恋人。公開された情報による被害も受けている。",
      "requires": {
        "type": "fact",
        "targetId": "fact_suspicious_email"
      }
    },
    {
      "id": "riko",
      "name": "和泉理子",
      "role": "参考人",
      "icon": "assets/icons/ayaka.png",
      "background": "assets/backgrounds/default-investigation.png",
      "description": "彩花と黒田、相沢の関係を知る友人。",
      "requires": {
        "type": "fact",
        "targetId": "fact_unknown_login"
      }
    },
    {
      "id": "jinai",
      "name": "陣内警部",
      "role": "上司",
      "icon": "assets/icons/ayaka.png",
      "background": "assets/backgrounds/default-investigation.png",
      "description": "捜査方針と必要な手続きを確認する上司。"
    },
    {
      "id": "aizawa",
      "name": "相沢拓海",
      "role": "参考人",
      "icon": "assets/icons/ayaka.png",
      "background": "assets/backgrounds/default-investigation.png",
      "description": "彩花と大学時代に面識がある人物。",
      "requires": {
        "type": "fact",
        "targetId": "fact_brightnet_subscriber"
      }
    },
    {
      "id": "asano",
      "name": "麻野巡査",
      "role": "捜査員",
      "icon": "assets/icons/ayaka.png",
      "background": "assets/backgrounds/default-investigation.png",
      "description": "事件の記録整理を担当する捜査員。",
      "requires": null
    }
  ],
  "conversations": [
    {
      "id": "conv_ayaka_first",
      "title": "彩花への初回聞き込み",
      "startNodeId": "ayaka_first_001",
      "completionEventId": "event_ayaka_first",
      "nodes": [
        {
          "id": "ayaka_first_001",
          "speakerId": "ayaka",
          "text": "アカウントに入れなくなってしまって……。昨日までは普通に使えていました。",
          "nextNodeId": "ayaka_first_002"
        },
        {
          "id": "ayaka_first_002",
          "speakerId": "player",
          "text": "アカウントに入れなくなる前に、何か変わったことはありましたか？",
          "choices": [
            {
              "text": "メールについて聞く",
              "nextNodeId": "ayaka_first_003"
            },
            {
              "text": "利用状況について聞く",
              "nextNodeId": "ayaka_first_003"
            }
          ]
        },
        {
          "id": "ayaka_first_003",
          "speakerId": "ayaka",
          "text": "SNSの運営からのようなメールが来ました。アカウントの確認が必要だと書いてあって、リンクを開いたと思います。",
          "nextNodeId": "ayaka_first_004"
        },
        {
          "id": "ayaka_first_004",
          "speakerId": "player",
          "text": "端末に記録が残っているか確認します。スマートフォンを預けてもらえますか？",
          "nextNodeId": "ayaka_first_005"
        },
        {
          "id": "ayaka_first_005",
          "speakerId": "ayaka",
          "text": "お願いします。何が起きたのか、知りたいです。"
        }
      ]
    },
    {
      "id": "conv_ayaka_followup",
      "title": "彩花への再確認",
      "requires": {
        "type": "and",
        "conditions": [
          {
            "type": "fact",
            "targetId": "fact_unknown_login"
          },
          {
            "type": "fact",
            "targetId": "fact_mailia_response"
          }
        ]
      },
      "startNodeId": "ayaka_followup_001",
      "nodes": [
        {
          "id": "ayaka_followup_001",
          "speakerId": "player",
          "text": "メールを受け取った時刻と、不審なログインの記録を確認しました。メールの後にリンクを開き、その後にログインが起きています。",
          "nextNodeId": "ayaka_followup_002"
        },
        {
          "id": "ayaka_followup_002",
          "speakerId": "ayaka",
          "text": "やっぱり、あのメールが原因だったんですね……。",
          "nextNodeId": "ayaka_followup_003"
        },
        {
          "id": "ayaka_followup_003",
          "speakerId": "player",
          "text": "原因を確定するため、記録を一つずつ確認します。あなたのせいだと決めつけることはありません。"
        }
      ]
    },
    {
      "id": "conv_kuroda",
      "title": "黒田への聞き込み",
      "requires": {
        "type": "fact",
        "targetId": "fact_suspicious_email"
      },
      "startNodeId": "kuroda_001",
      "nodes": [
        {
          "id": "kuroda_001",
          "speakerId": "kuroda",
          "text": "彩花から、見覚えのないメールが届いたと聞いています。僕にも同じような内容が送られてきました。",
          "nextNodeId": "kuroda_002"
        },
        {
          "id": "kuroda_002",
          "speakerId": "player",
          "text": "相沢拓海さんという人物に心当たりはありますか？",
          "choices": [
            {
              "text": "大学時代の関係を聞く",
              "nextNodeId": "kuroda_003"
            },
            {
              "text": "被害の内容を確認する",
              "nextNodeId": "kuroda_003"
            }
          ]
        },
        {
          "id": "kuroda_003",
          "speakerId": "kuroda",
          "text": "大学時代の知人です。彩花に好意を持っていたようですが、今の段階で犯人と決めつける材料はありません。"
        }
      ]
    },
    {
      "id": "conv_riko",
      "title": "和泉への聞き込み",
      "requires": {
        "type": "and",
        "conditions": [
          {
            "type": "fact",
            "targetId": "fact_suspicious_email"
          },
          {
            "type": "fact",
            "targetId": "fact_unknown_login"
          }
        ]
      },
      "startNodeId": "riko_001",
      "nodes": [
        {
          "id": "riko_001",
          "speakerId": "riko",
          "text": "相沢くんは、彩花のことをずっと気にしていました。黒田さんとの関係を知ってから、様子が変わったと思います。",
          "nextNodeId": "riko_002"
        },
        {
          "id": "riko_002",
          "speakerId": "player",
          "text": "相沢さんが犯人だと考えていますか？",
          "choices": [
            {
              "text": "断定せず、知っている事実を聞く",
              "nextNodeId": "riko_003"
            },
            {
              "text": "相沢さんを疑っていると伝える",
              "nextNodeId": "riko_003"
            }
          ]
        },
        {
          "id": "riko_003",
          "speakerId": "riko",
          "text": "疑うことと決めつけることは違います。大学の頃、彩花に何度も二人で会おうとしていました。"
        }
      ]
    },
    {
      "id": "conv_jinai_search",
      "title": "捜索の相談",
      "requires": {
        "type": "and",
        "conditions": [
          {
            "type": "fact",
            "targetId": "fact_brightnet_subscriber"
          },
          {
            "type": "fact",
            "targetId": "fact_mailia_response"
          },
          {
            "type": "fact",
            "targetId": "fact_nexhost_access"
          }
        ]
      },
      "startNodeId": "jinai_001",
      "completionEventId": "event_jinai_search",
      "nodes": [
        {
          "id": "jinai_001",
          "speakerId": "jinai",
          "text": "相沢の回線からフィッシングサイトへのアクセスがあり、メールの記録もある。だが、契約者情報だけで本人の犯行と決めるな。",
          "nextNodeId": "jinai_002"
        },
        {
          "id": "jinai_002",
          "speakerId": "player",
          "text": "端末にサイトの操作やメール送信の記録が残っているか確認したいと考えています。対象と目的を整理して手続きを進めます。",
          "nextNodeId": "jinai_003"
        },
        {
          "id": "jinai_003",
          "speakerId": "jinai",
          "text": "筋は見えている。必要な手続きを踏み、本人の端末と関係資料を確認しろ。崩れない捜査をするんだ。"
        }
      ]
    },
    {
      "id": "conv_aizawa_first",
      "title": "相沢への初回接触",
      "requires": {
        "type": "fact",
        "targetId": "fact_brightnet_subscriber"
      },
      "startNodeId": "aizawa_first_001",
      "completionEventId": "event_aizawa_first",
      "nodes": [
        {
          "id": "aizawa_first_001",
          "speakerId": "aizawa",
          "text": "黒田先輩から聞きました。大変なことになったみたいですね。彩花さん、気の毒に。",
          "nextNodeId": "aizawa_first_002"
        },
        {
          "id": "aizawa_first_002",
          "speakerId": "player",
          "text": "事件当日の行動について確認させてください。",
          "nextNodeId": "aizawa_first_003"
        },
        {
          "id": "aizawa_first_003",
          "speakerId": "aizawa",
          "text": "仕事をしていました。フリーランスなので、家で作業することも多いです。早く犯人が見つかるといいですね。"
        }
      ]
    },
    {
      "id": "conv_aizawa_final",
      "title": "最終追及",
      "requires": {
        "type": "and",
        "conditions": [
          {
            "type": "fact",
            "targetId": "fact_site_history"
          },
          {
            "type": "fact",
            "targetId": "fact_mail_sent"
          },
          {
            "type": "fact",
            "targetId": "fact_credentials_note"
          },
          {
            "type": "fact",
            "targetId": "fact_motive_note"
          }
        ]
      },
      "startNodeId": "aizawa_final_001",
      "completionEventId": "event_case_clear",
      "nodes": [
        {
          "id": "aizawa_final_001",
          "speakerId": "player",
          "text": "確認したいことがあります。まず、事件に使われたフィッシングサイトの閲覧履歴について説明してください。",
          "nextNodeId": "aizawa_final_002"
        },
        {
          "id": "aizawa_final_002",
          "speakerId": "aizawa",
          "text": "仕事でいろいろなサイトを見ます。それだけでは、僕が作ったとは言えません。",
          "nextNodeId": "aizawa_final_003"
        },
        {
          "id": "aizawa_final_003",
          "speakerId": "player",
          "text": "では、彩花さんへ送ったメールの記録はどうですか？",
          "nextNodeId": "aizawa_final_004"
        },
        {
          "id": "aizawa_final_004",
          "speakerId": "aizawa",
          "text": "誰かが僕のアカウントを使ったんじゃないですか。",
          "nextNodeId": "aizawa_final_005"
        },
        {
          "id": "aizawa_final_005",
          "speakerId": "player",
          "text": "彩花さんのIDとパスワードが、あなたの端末にありました。さらに、犯行の計画メモもあります。",
          "nextNodeId": "aizawa_final_006"
        },
        {
          "id": "aizawa_final_006",
          "speakerId": "aizawa",
          "text": "黒田先輩は、何でも持っていた。彩花さんまで。僕を見てほしかったんです。……はい。僕がやりました。"
        }
      ]
    },
    {
      "id": "conv_jinai_intro",
      "title": "陣内警部への相談",
      "startNodeId": "jinai_intro_001",
      "completionEventId": "event_jinai_intro",
      "nodes": [
        {
          "id": "jinai_intro_001",
          "speakerId": "jinai",
          "text": "まずは藤崎さんへの聞き取りを進めろ。本人から、起きたことと端末に残っている資料を確認するんだ。"
        }
      ]
    },
    {
      "id": "conv_asano_intro",
      "title": "麻野巡査からの案内",
      "startNodeId": "asano_intro_001",
      "completionEventId": "event_asano_intro",
      "nodes": [
        {
          "id": "asano_intro_001",
          "speakerId": "asano",
          "text": "藤崎さんの端末を確認できれば、メールやアクセス記録を整理できます。まずは藤崎さんへ聞き取りをお願いします。"
        }
      ]
    }
  ],
