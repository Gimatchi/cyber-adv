{
  "schemaVersion": 1,
  "id": "case001",
  "title": "SNS乗っ取り",
  "defaults": {
    "background": "assets/backgrounds/default-investigation.png",
    "characterIcon": "assets/icons/ayaka.png"
  },
  "characters": [
    {
      "id": "ayaka",
      "name": "藤崎彩花",
      "role": "被害者",
      "icon": "assets/icons/ayaka.png",
      "background": "assets/backgrounds/ayaka-selection.png",
      "description": "SNSアカウントを乗っ取られた被害者。"
    },
    {
      "id": "kuroda",
      "name": "黒田恒一",
      "role": "被害関係者",
      "icon": "assets/icons/ayaka.png",
      "background": "assets/backgrounds/default-investigation.png",
      "description": "彩花の恋人。公開された情報による被害も受けている。"
    },
    {
      "id": "riko",
      "name": "和泉理子",
      "role": "参考人",
      "icon": "assets/icons/ayaka.png",
      "background": "assets/backgrounds/default-investigation.png",
      "description": "彩花の友人。3人の関係について知っている。"
    }
  ],
  "conversations": [
    {
      "id": "conv_mika_first",
      "title": "彩花への聞き込み",
      "background": "assets/backgrounds/interview-room.png",
      "startNodeId": "conv_mika_first_001",
      "completionEventId": "event_conv_mika_first",
      "nodes": [
        {
          "id": "conv_mika_first_001",
          "speakerId": "ayaka",
          "icon": "assets/icons/ayaka.png",
          "text": "アカウントに入れなくなってしまって……。\n昨日までは普通に使えていました。",
          "nextNodeId": "conv_mika_first_002"
        },
        {
          "id": "conv_mika_first_002",
          "speakerId": "player",
          "text": "何か、直前に変わったことはありましたか？",
          "choices": [
            {
              "text": "メールについて聞く",
              "nextNodeId": "conv_mika_first_003"
            },
            {
              "text": "利用状況について聞く",
              "nextNodeId": "conv_mika_first_003"
            }
          ]
        },
        {
          "id": "conv_mika_first_003",
          "speakerId": "ayaka",
          "icon": "assets/icons/ayaka.png",
          "text": "スマートフォンをお預けします。\n中を確認してもらえますか？"
        }
      ]
    },
    {
      "id": "conv_mika_followup",
      "title": "彩花への追加確認",
      "requires": {
        "type": "fact",
        "targetId": "fact_unknown_login",
        "operator": "exists"
      },
      "startNodeId": "conv_mika_followup_001",
      "nodes": [
        {
          "id": "conv_mika_followup_001",
          "speakerId": "ayaka",
          "text": "その時間は、私はログインしていません。"
        }
      ]
    },
    {
      "id": "conv_mika_route",
      "title": "判明事項による案内",
      "startNodeId": "conv_mika_route_001",
      "nodes": [
        {
          "id": "conv_mika_route_001",
          "routes": [
            {
              "requires": {
                "type": "fact",
                "targetId": "fact_unknown_login",
                "operator": "exists"
              },
              "nextNodeId": "conv_mika_route_known"
            },
            {
              "nextNodeId": "conv_mika_route_unknown"
            }
          ]
        },
        {
          "id": "conv_mika_route_known",
          "speakerId": "narrator",
          "text": "不審な接続元が判明しています。追加確認へ進みます。"
        },
        {
          "id": "conv_mika_route_unknown",
          "speakerId": "narrator",
          "text": "まずはアクセスログを確認します。"
        }
      ]
    },
    {
      "id": "conv_kuroda_context",
      "title": "黒田への聞き込み",
      "requires": {
        "type": "fact",
        "targetId": "fact_suspicious_email",
        "operator": "exists"
      },
      "startNodeId": "conv_kuroda_001",
      "nodes": [
        {
          "id": "conv_kuroda_001",
          "speakerId": "kuroda",
          "text": "彩花から、見覚えのないメールが届いたと聞いています。\n私にも同じような内容が送られてきました。",
          "nextNodeId": "conv_kuroda_002"
        },
        {
          "id": "conv_kuroda_002",
          "speakerId": "player",
          "text": "相沢拓海という人物に心当たりはありますか？",
          "choices": [
            {
              "text": "大学時代の関係を聞く",
              "nextNodeId": "conv_kuroda_003"
            },
            {
              "text": "被害の内容を確認する",
              "nextNodeId": "conv_kuroda_003"
            }
          ]
        },
        {
          "id": "conv_kuroda_003",
          "speakerId": "kuroda",
          "text": "大学時代の知人です。彩花に好意を持っていたようですが、詳しくは分かりません。"
        }
      ]
    },
    {
      "id": "conv_riko_reference",
      "title": "和泉への聞き込み",
      "requires": {
        "type": "and",
        "conditions": [
          {
            "type": "fact",
            "targetId": "fact_suspicious_email",
            "operator": "exists"
          },
          {
            "type": "fact",
            "targetId": "fact_unknown_login",
            "operator": "exists"
          }
        ]
      },
      "startNodeId": "conv_riko_001",
      "nodes": [
        {
          "id": "conv_riko_001",
          "speakerId": "riko",
          "text": "相沢くんは、彩花のことをずっと気にしていました。\n黒田さんとの関係を知ってから、様子が変わったと思います。"
        }
      ]
    }
  ],
